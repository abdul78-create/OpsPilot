# ─────────────────────────────────────────────────────────────
#  OpsPilot AI — Production Environment Configuration (.env)
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ── Cloud PostgreSQL Database ────────────────────────────────
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=generate_strong_64_char_db_password_here
POSTGRES_DB=opspilot
DATABASE_URL=postgresql://opspilot:generate_strong_64_char_db_password_here@postgres:5432/opspilot?schema=public&connection_limit=50&pool_timeout=30

# ── Managed Redis Cluster / Queue ────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ── Cryptographic Secrets & JWT ──────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_secure_random_base64_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_a_secure_random_base64_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ── AES-256-GCM Master Vault Encryption Key ──────────────────
# MUST be exact 64-char hexadecimal string (32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Production Domain & CORS ─────────────────────────────────
FRONTEND_URL=https://opspilot.ai
API_URL=https://opspilot.ai/v1
NEXT_PUBLIC_API_URL=/v1
CORS_ORIGIN=https://opspilot.ai,https://www.opspilot.ai,https://api.opspilot.ai

# ── GitHub OAuth & App Integration ───────────────────────────
GITHUB_CLIENT_ID=gh_prod_client_id
GITHUB_CLIENT_SECRET=gh_prod_client_secret
GITHUB_WEBHOOK_SECRET=gh_webhook_hmac_secret

# ── Stripe Commercial SaaS Billing ───────────────────────────
STRIPE_SECRET_KEY=sk_live_prod_key
STRIPE_PUBLISHABLE_KEY=pk_live_prod_key
STRIPE_WEBHOOK_SECRET=whsec_prod_webhook_secret

# ── AI Root Cause Analysis (OpenAI / Claude / Gemini) ────────
OPENAI_API_KEY=sk-prod-openai-key
AI_MODEL=gpt-4o

# ── Logging & Telemetry ──────────────────────────────────────
LOG_LEVEL=info
SWAGGER_PATH=api/docs
PROMETHEUS_METRICS_ENABLED=true
