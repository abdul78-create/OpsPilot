# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────
# Local: postgresql://user:password@localhost:5432/opspilot
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opspilot?schema=public"

# ── Redis / BullMQ ────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Authentication ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-secret-here

# ── Encryption (AES-256-GCM for Secrets module) ───────────────
# Must be exactly 32 bytes (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── API Docs ──────────────────────────────────────────────────
SWAGGER_PATH=api/docs

# ── AI Provider (optional — falls back to rule-based) ─────────
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# ── Frontend URL ──────────────────────────────────────────────
# FRONTEND_URL=http://localhost:3001

# ── Google OAuth 2.0 (Optional) ───────────────────────────────
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI: http://localhost:3000/v1/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# ── GitHub OAuth (Optional) ───────────────────────────────────
# Create an OAuth App in GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: http://localhost:3000/v1/auth/github/callback
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_CALLBACK_URL=http://localhost:3000/v1/auth/github/callback
